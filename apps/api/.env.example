# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string (get from Atlas dashboard -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-codebase-assistant

# JWT
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Embeddings run locally via @huggingface/transformers - no API key, no
# account, no payment method needed. The model downloads once (~90MB) on
# first use and is cached locally afterward. Override only if you want a
# different ONNX sentence-embedding model.
LOCAL_EMBEDDING_MODEL=onnx-community/all-MiniLM-L6-v2-ONNX

# Groq API (get a free API key from https://console.groq.com - no
# payment method required)
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024
CHAT_RETRIEVAL_TOP_K=8

# Rate limiting. Windows are fixed in code (15 min for auth, 1 hour for
# import/chat); only the request counts are configurable here.
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_IMPORT_MAX=10
RATE_LIMIT_CHAT_MAX=30

# Comma-separated list of origins allowed to make browser cross-origin
# requests. Default covers common local dev frontend ports. A real
# deployment MUST override this with its actual frontend origin(s).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Repo import limits - reject repos larger than this rather than let an
# import run indefinitely or exhaust memory/disk
MAX_REPO_FILES=3000
MAX_FILE_SIZE_KB=500

# Optional. Raises the GitHub API rate limit from 60/hour (shared across
# your whole network) to 5000/hour. Generate at github.com -> Settings ->
# Developer settings -> Personal access tokens -> Fine-grained tokens.
# No scopes/permissions needed for reading public repo metadata.
GITHUB_TOKEN=
